{
  "name": "bridge-for-i",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.12.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarzom-ibmi/bridge-for-ibm-i.git"
  },
  "homepage": "https://github.com/jarzom-ibmi/bridge-for-ibm-i#readme",
  "bugs": {
    "url": "https://github.com/jarzom-ibmi/bridge-for-ibm-i/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node check-docs.mjs",
    "release": "node release.mjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "halcyontechltd.code-for-ibmi"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bridgeForI.pull",
        "title": "%cmd.pull%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.pullMember",
        "title": "%cmd.pullMember%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.pullFile",
        "title": "%cmd.pullFile%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.pullLibrary",
        "title": "%cmd.pullLibrary%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.compile",
        "title": "%cmd.compile%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.uploadCurrent",
        "title": "%cmd.uploadCurrent%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.uploadFolder",
        "title": "%cmd.uploadFolder%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.pullCurrent",
        "title": "%cmd.pullCurrent%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.openManual",
        "title": "%cmd.openManual%",
        "category": "IBM i Bridge"
      },
      {
        "command": "bridgeForI.uploadPending",
        "title": "%cmd.uploadPending%",
        "category": "IBM i Bridge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bridgeForI.statusRefresh",
        "title": "%cmd.statusRefresh%",
        "category": "IBM i Bridge",
        "icon": "$(refresh)"
      },
      {
        "command": "bridgeForI.showOutput",
        "title": "%cmd.showOutput%",
        "category": "IBM i Bridge",
        "icon": "$(output)"
      },
      {
        "command": "bridgeForI.uploadItem",
        "title": "%cmd.uploadItem%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bridgeForI.diffItem",
        "title": "%cmd.diffItem%",
        "icon": "$(diff)"
      },
      {
        "command": "bridgeForI.pullItem",
        "title": "%cmd.pullItem%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bridgeForI.dismissItem",
        "title": "%cmd.dismissItem%",
        "icon": "$(close)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bridgeForI.status",
          "name": "%view.status%",
          "contextualTitle": "%view.status%",
          "icon": "$(plug)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bridgeForI.status",
        "contents": "%view.welcome%",
        "when": "!bridgeForI.hasMirror"
      }
    ],
    "submenus": [
      {
        "id": "bridgeForI.pullSubmenu",
        "label": "%cmd.pullNode%"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "bridgeForI.pullMember", "when": "false" },
        { "command": "bridgeForI.pullFile", "when": "false" },
        { "command": "bridgeForI.pullLibrary", "when": "false" },
        { "command": "bridgeForI.uploadItem", "when": "false" },
        { "command": "bridgeForI.diffItem", "when": "false" },
        { "command": "bridgeForI.pullItem", "when": "false" },
        { "command": "bridgeForI.dismissItem", "when": "false" }
      ],
      "view/title": [
        { "command": "bridgeForI.uploadPending", "when": "view == bridgeForI.status", "group": "navigation@1" },
        { "command": "bridgeForI.statusRefresh", "when": "view == bridgeForI.status", "group": "navigation@2" },
        { "command": "bridgeForI.showOutput", "when": "view == bridgeForI.status", "group": "navigation@3" }
      ],
      "bridgeForI.pullSubmenu": [
        {
          "command": "bridgeForI.pullMember",
          "when": "viewItem == member",
          "group": "pull@1"
        },
        {
          "command": "bridgeForI.pullFile",
          "when": "viewItem == member || viewItem == SPF",
          "group": "pull@2"
        },
        {
          "command": "bridgeForI.pullLibrary",
          "group": "pull@3"
        }
      ],
      "extension/context": [
        {
          "command": "bridgeForI.openManual",
          "when": "extension == local.bridge-for-i && extensionStatus == installed"
        }
      ],
      "explorer/context": [
        {
          "command": "bridgeForI.uploadFolder",
          "when": "explorerResourceIsFolder",
          "group": "claudebridge@1"
        }
      ],
      "view/item/context": [
        { "command": "bridgeForI.uploadItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "inline@1" },
        { "command": "bridgeForI.diffItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "inline@2" },
        { "command": "bridgeForI.pullItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "inline@3" },
        { "command": "bridgeForI.dismissItem", "when": "view == bridgeForI.status && viewItem =~ /^(conflict|failed)$/", "group": "inline@4" },
        { "command": "bridgeForI.uploadItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "bridge@1" },
        { "command": "bridgeForI.diffItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "bridge@2" },
        { "command": "bridgeForI.pullItem", "when": "view == bridgeForI.status && viewItem =~ /^(pending|conflict|failed)$/", "group": "bridge@3" },
        { "command": "bridgeForI.dismissItem", "when": "view == bridgeForI.status && viewItem =~ /^(conflict|failed)$/", "group": "bridge@4" },
        {
          "submenu": "bridgeForI.pullSubmenu",
          "when": "view == objectBrowser && viewItem =~ /^(member|SPF|object\\.lib|filter_library)/",
          "group": "claudebridge@1"
        },
        {
          "submenu": "bridgeForI.pullSubmenu",
          "when": "view == libraryListView && viewItem =~ /library/",
          "group": "claudebridge@1"
        },
        {
          "command": "bridgeForI.uploadFolder",
          "when": "view == objectBrowser && viewItem == member",
          "group": "claudebridge@2"
        },
        {
          "command": "bridgeForI.uploadFolder",
          "when": "view == objectBrowser && viewItem == SPF",
          "group": "claudebridge@2"
        }
      ]
    },
    "configuration": {
      "title": "%cfg.title%",
      "properties": {
        "bridgeForI.targetLibrary": {
          "type": "string",
          "default": "",
          "description": "%cfg.targetLibrary%"
        },
        "bridgeForI.mirrorFolder": {
          "type": "string",
          "default": "ibmi",
          "description": "%cfg.mirrorFolder%"
        },
        "bridgeForI.autoUploadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoUpload%"
        },
        "bridgeForI.conflictCheck": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.conflictCheck%"
        }
      }
    }
  },
  "author": {
    "name": "Glenn Jarzomkowski",
    "email": "jarzom@gmail.com"
  },
  "icon": "icon.png"
}